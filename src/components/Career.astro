---
const roles = [
  {
    company: 'Place',
    role: 'Founder',
    period: '2025 — Now',
    status: 'Current',
    description:
      'An AI-powered travel and discovery companion that delivers GPS-triggered audio stories as you move through the world. Currently raising pre-seed funding.',
  },
  {
    company: 'Zeti',
    role: 'Director of Product & Operations',
    period: '2018 — Now',
    status: 'Current',
    description:
      'London fintech building usage-based financing infrastructure for transport and energy assets. Led the product from no-code MVP through to a proprietary Azure platform. Now leading ZetiOS toward Series B.',
  },
  {
    company: 'Shandy Shack',
    role: 'Co-Founder & CEO',
    period: '2018 — 2025',
    description:
      "Built an award-winning British craft drinks brand from a festival pop-up to national grocery distribution (Sainsbury's, Aldi) and a seven-figure acquisition by SHS Drinks (owners of WKD and Shloer) in November 2024.",
  },
  {
    company: 'Accenture Song',
    role: 'Digital Strategy Consultant',
    period: '2015 — 2018',
    description:
      'Innovation and venture strategy for international clients across pharma, hospitality, government and financial services. Projects included a £1.5m agile health innovation hub and a blockchain opportunity assessment for a Paris-based bank.',
  },
  {
    company: 'The Hut Group',
    role: 'International Trading Manager',
    period: '2014 — 2015',
    description:
      "First role out of university. Exceeded sales targets by 35% managing international performance marketing for one of the UK's largest eCommerce platforms.",
  },
];
---

<section class="career section" id="career">
  <div class="container">
    <p class="mono-label section__eyebrow">
      <span>02</span>
      <span class="career__sep" aria-hidden="true">——</span>
      <span>Selected work</span>
    </p>

    <h2 class="section__title">
      A career across <em class="serif-italic">every stage.</em>
    </h2>

    <ol class="career__list">
      {
        roles.map((role) => (
          <li class="role">
            <div class="role__meta">
              <p class="mono role__period">{role.period}</p>
              {role.status && (
                <p class="role__status">
                  <span class="dot" aria-hidden="true" />
                  <span>{role.status}</span>
                </p>
              )}
            </div>
            <div class="role__body">
              <h3 class="role__company">{role.company}</h3>
              <p class="role__title">{role.role}</p>
              <p class="role__description">{role.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .career__sep {
    color: var(--ink-4);
  }

  .section__title em.serif-italic {
    color: var(--ink);
  }

  .career__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .role {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .role:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 640px) {
    .role {
      grid-template-columns: 160px 1fr;
      gap: var(--s-6);
    }
  }

  .role__meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-top: 0.45rem;
  }

  .role__period {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .role__status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .role__status .dot {
    margin-left: 0;
  }

  .role__company {
    font-size: var(--fs-lg);
    margin-bottom: var(--s-1);
  }

  .role__title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--s-4);
  }

  .role__description {
    color: var(--ink-2);
    max-width: 60ch;
  }
</style>
