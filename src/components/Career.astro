---
const roles = [
  {
    company: 'Place',
    role: 'Founder',
    period: '2025 — present',
    description:
      'An AI-powered travel and discovery companion that delivers GPS-triggered audio stories as you move through the world. Currently raising pre-seed funding.',
  },
  {
    company: 'Zeti',
    role: 'Director of Product & Operations',
    period: '2018 — present',
    description:
      'London fintech building usage-based financing infrastructure for transport and energy assets. Led the product from no-code MVP through to a proprietary Azure platform. Now leading ZetiOS toward Series B.',
  },
  {
    company: 'Shandy Shack',
    role: 'Co-Founder & CEO',
    period: '2018 — 2025',
    description:
      "Built an award-winning British craft drinks brand from a festival pop-up to national grocery distribution (Sainsbury's, Aldi) and a seven-figure acquisition by SHS Drinks (owners of WKD and Shloer) in November 2024.",
  },
  {
    company: 'Accenture Song',
    role: 'Digital Strategy Consultant',
    period: '2015 — 2018',
    description:
      'Innovation and venture strategy for international clients across pharma, hospitality, government and financial services. Projects included a £1.5m agile health innovation hub and a blockchain opportunity assessment for a Paris-based bank.',
  },
  {
    company: 'The Hut Group',
    role: 'International Trading Manager',
    period: '2014 — 2015',
    description:
      "First role out of university. Exceeded sales targets by 35% managing international performance marketing for one of the UK's largest eCommerce platforms.",
  },
];
---

<section class="career section" id="career">
  <div class="container">
    <p class="section__eyebrow">Career</p>
    <h2 class="section__title">Selected work</h2>
    <ol class="career__list">
      {
        roles.map((role) => (
          <li class="role">
            <div class="role__meta">
              <p class="role__period">{role.period}</p>
            </div>
            <div class="role__body">
              <h3 class="role__company">{role.company}</h3>
              <p class="role__title">{role.role}</p>
              <p class="role__description">{role.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .career__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .role {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .role {
      grid-template-columns: 140px 1fr;
      gap: var(--space-5);
    }
  }

  .role__period {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colour-ink-soft);
    padding-top: 0.35rem;
  }

  .role__company {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-1);
  }

  .role__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--colour-ink);
    margin-bottom: var(--space-3);
  }

  .role__description {
    color: var(--colour-ink-muted);
    max-width: 60ch;
  }
</style>
