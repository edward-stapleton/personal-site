---
---

<section class="hero section section--flush" id="top">
  <div class="container">
    <p class="mono-label hero__meta">
      <span>London</span>
    </p>

    <h1 class="hero__headline">
      Venture builder. Product operator. <em class="serif-italic">Founder.</em>
    </h1>

    <p class="hero__sub">
      10 years building and scaling products, brands and businesses —
      from zero to acquisition and beyond.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">
        Get in touch
        <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="btn btn--ghost" href="#career">See my work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--s-10) var(--s-9);
  }

  .hero__meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-7);
  }

  .hero__meta-sep {
    color: var(--ink-4);
  }

  .hero__headline {
    font-size: clamp(2.5rem, 7vw, var(--fs-4xl));
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--s-5);
    max-width: 14ch;
  }

  .hero__headline em.serif-italic {
    font-size: 1.05em;
    color: var(--ink);
  }

  .hero__sub {
    font-size: var(--fs-lg);
    color: var(--ink-2);
    max-width: 48ch;
    margin-bottom: var(--s-7);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
