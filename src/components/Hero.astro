---
---

<section class="hero section" id="top">
  <div class="container">
    <p class="hero__name">Ed Stapleton</p>
    <h1 class="hero__headline">
      Venture builder. Product operator. Founder.
    </h1>
    <p class="hero__sub">
      10 years building and scaling products, brands and businesses —
      from zero to acquisition and beyond.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">Get in touch</a>
      <a class="btn btn--ghost" href="#career">See my work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-10) var(--space-9);
  }

  .hero__name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--colour-ink-soft);
    margin-bottom: var(--space-5);
  }

  .hero__headline {
    margin-bottom: var(--space-5);
    max-width: 18ch;
  }

  .hero__sub {
    font-size: var(--fs-md);
    color: var(--colour-ink-muted);
    max-width: 48ch;
    margin-bottom: var(--space-7);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__actions .btn {
    border-bottom-width: 1px;
  }
</style>
