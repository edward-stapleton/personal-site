---
// Grey-box stand-in for a world's illustration: an isometric diorama drawn
// from the chapter's blocks on the same 1600×900 canvas the artwork will use.
import type { Chapter, OfficeStyle } from '../../data/chapters';
import { GRID, SCENE_H, SCENE_W, project } from '../../lib/iso';

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;

const pts = (list: [number, number, number][]) =>
  list.map(([x, y, z]) => project(x, y, z).map((n) => n.toFixed(1)).join(',')).join(' ');

function shade(hex: string, k: number) {
  const n = parseInt(hex.slice(1), 16);
  const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => Math.min(255, Math.round(v * k)));
  return `rgb(${c.join(',')})`;
}

type Face = { points?: string; d?: string; fill: string; opacity?: number };
type Piece = { depth: number; faces: Face[]; sign?: { text: string; transform: string; size: number } };

function box(x: number, y: number, w: number, d: number, h: number, color: string, z = 0): Face[] {
  return [
    { points: pts([[x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]]), fill: color },
    { points: pts([[x, y + d, z], [x + w, y + d, z], [x + w, y + d, z + h], [x, y + d, z + h]]), fill: shade(color, 0.8) },
    { points: pts([[x + w, y, z], [x + w, y + d, z], [x + w, y + d, z + h], [x + w, y, z + h]]), fill: shade(color, 0.9) },
  ];
}

const pieces: Piece[] = [];

function signOn(x: number, y: number, w: number, d: number, h: number, z: number, text: string) {
  const [ox, oy] = project(x + w / 2, y + d, z + h / 2);
  return {
    text,
    size: Math.min(26, h * 62 * 0.34, (w * 62 * 0.9) / Math.max(3, text.length * 0.6)),
    transform: `matrix(0.866 0.5 0 1 ${ox.toFixed(1)} ${oy.toFixed(1)})`,
  };
}

function tank(x: number, y: number, w: number, h: number, color: string): Face[] {
  // Iso circle of radius r: ellipse rx = r·U·√2·cos30, ry = r·U·√2·sin30.
  const r = w / 2;
  const [cx, cy] = project(x + r, y + r, 0);
  const rx = r * 62 * 1.2247;
  const ry = r * 62 * 0.7071;
  const top = cy - h * 62;
  return [
    { d: `M${cx - rx},${top} L${cx - rx},${cy} A${rx},${ry} 0 0 0 ${cx + rx},${cy} L${cx + rx},${top} Z`, fill: shade(color, 0.85) },
    { d: `M${cx - rx},${top} A${rx},${ry} 0 1 0 ${cx + rx},${top} A${rx},${ry} 0 1 0 ${cx - rx},${top} Z`, fill: color },
  ];
}

function pallets(x: number, y: number, w: number, d: number, color: string): Face[] {
  const faces: Face[] = [];
  for (let i = 0; i + 0.5 <= w + 0.01; i += 0.6) {
    for (let j = 0; j + 0.5 <= d + 0.01; j += 0.6) {
      faces.push(...box(x + i, y + j, 0.5, 0.5, 0.1, '#b8905e'));
      faces.push(...box(x + i + 0.03, y + j + 0.03, 0.44, 0.44, 0.34, color, 0.1));
    }
  }
  return faces;
}

for (const b of chapter.blocks) {
  const [x, y, w, d, h] = b.at;
  const piece: Piece = { depth: x + w / 2 + y + d / 2, faces: [] };
  if (b.kind === 'tank') {
    piece.faces = tank(x, y, w, h, b.color);
  } else if (b.kind === 'pallets') {
    piece.faces = pallets(x, y, w, d, b.color);
  } else if (b.kind === 'billboard') {
    const legs = h * 0.4;
    piece.faces = [
      ...box(x + w * 0.2, y, 0.08, 0.08, legs, '#6b6b70'),
      ...box(x + w * 0.75, y, 0.08, 0.08, legs, '#6b6b70'),
      ...box(x, y, w, d, h - legs, b.color, legs),
    ];
    if (b.sign) piece.sign = signOn(x, y, w, d, h - legs, legs, b.sign);
  } else {
    piece.faces = box(x, y, w, d, h, b.color);
    if (b.sign && h >= 0.5) {
      piece.sign = signOn(x, y, w, d, h, 0, b.sign);
    } else if (b.sign) {
      // Flat blocks (pitches, pools) carry their sign painted on the top face.
      const [ox, oy] = project(x + w / 2, y + d / 2, h);
      piece.sign = {
        text: b.sign,
        size: Math.min(24, (w * 62 * 0.8) / Math.max(3, b.sign.length * 0.6)),
        transform: `matrix(0.866 0.5 -0.866 0.5 ${ox.toFixed(1)} ${oy.toFixed(1)})`,
      };
    }
  }
  pieces.push(piece);
}

// Cut-away office: floor, two back walls and a desk; the front is open so Ed
// stays visible once he has walked in. Each world's office has its own
// character so they read differently even in grey-box.
type Extra = 'roof' | 'glass' | 'upper' | 'screens' | 'shelves' | 'balcony' | 'mansard';
const officeLooks: Record<OfficeStyle, { wall: string; side: string; floor: string; height: number; extra?: Extra }> = {
  estate: { wall: '#b8573f', side: '#a24c37', floor: '#e9dcc6', height: 1.5, extra: 'upper' },
  glass: { wall: '#bcd6ee', side: '#a8c6e2', floor: '#f4f6f8', height: 1.4, extra: 'glass' },
  shack: { wall: '#c89a62', side: '#b5874f', floor: '#e2c79c', height: 1.1, extra: 'roof' },
  tower: { wall: '#d9d2f0', side: '#c6bde6', floor: '#f2f0f7', height: 1.3 },
  trading: { wall: '#e6e7ea', side: '#d6d8dc', floor: '#f4f4f5', height: 1.3, extra: 'screens' },
  modernista: { wall: '#ecd9b8', side: '#dcc7a2', floor: '#efe3cc', height: 1.6, extra: 'balcony' },
  loft: { wall: '#efe6d6', side: '#e0d5c2', floor: '#e3d2b4', height: 1.4, extra: 'mansard' },
  library: { wall: '#c8b893', side: '#b7a680', floor: '#8a6547', height: 1.5, extra: 'shelves' },
  studio: { wall: '#ffffff', side: '#f0efe9', floor: '#f7f5f0', height: 1.3 },
};

{
  const [x, y, w, d] = chapter.office;
  const look = officeLooks[chapter.officeStyle];
  const H = look.height;
  const wallOpacity = look.extra === 'glass' ? 0.55 : 1;
  const faces: Face[] = [
    { points: pts([[x, y, 0.05], [x + w, y, 0.05], [x + w, y + d, 0.05], [x, y + d, 0.05]]), fill: look.floor },
    { points: pts([[x, y, 0], [x + w, y, 0], [x + w, y, H], [x, y, H]]), fill: look.wall, opacity: wallOpacity },
    { points: pts([[x, y, 0], [x, y + d, 0], [x, y + d, H], [x, y, H]]), fill: look.side, opacity: wallOpacity },
    { points: pts([[x, y, H], [x + w, y, H], [x + w, y + 0.12, H], [x, y + 0.12, H]]), fill: shade(look.wall, 0.85) },
    { points: pts([[x, y, H], [x + 0.12, y, H], [x + 0.12, y + d, H], [x, y + d, H]]), fill: shade(look.side, 0.85) },
    ...box(x + w * 0.2, y + d * 0.12, w * 0.6, d * 0.3, 0.42, look.extra === 'glass' ? '#f7f7f7' : '#b08a62'),
  ];
  if (look.extra === 'roof') {
    // Corrugated roof over the back half, plus the bar counter and its taps.
    faces.push(...box(x - 0.15, y - 0.15, w + 0.3, d * 0.55, 0.1, '#8d9aa3', H));
    faces.push(...box(x + 0.1, y + d - 0.3, w - 0.2, 0.25, 0.45, '#9c6b3f'));
    for (let i = 0; i < 4; i++) faces.push(...box(x + 0.3 + i * 0.35, y + d - 0.22, 0.08, 0.08, 0.72, '#d9dde2'));
  } else if (look.extra === 'upper') {
    faces.push(...box(x, y, w, 0.3, 0.9, '#b8573f', H));
    faces.push(...box(x + 0.6, y + 0.05, 0.25, 0.2, 0.6, '#8f4331', H + 0.9));
  } else if (look.extra === 'screens') {
    for (let i = 0; i < 3; i++) faces.push(...box(x + 0.25 + i * 0.5, y + 0.05, 0.4, 0.05, 0.3, '#1f2a44', 0.75));
  } else if (look.extra === 'glass') {
    faces.push(...box(x + 0.2, y + 0.05, 1.3, 0.05, 0.45, '#1f2a44', 0.6));
  } else if (look.extra === 'shelves') {
    faces.push(...box(x + 0.1, y + 0.05, w - 0.2, 0.2, 1.2, '#6f4e35'));
  } else if (look.extra === 'balcony') {
    faces.push(...box(x, y, w, 0.25, 0.9, '#ecd9b8', H));
    faces.push(...box(x + 0.2, y + 0.25, w - 0.4, 0.25, 0.06, '#3c3c40', H + 0.1));
  } else if (look.extra === 'mansard') {
    faces.push(...box(x, y, w, 0.5, 0.7, '#7e8a95', H));
  }
  pieces.push({ depth: x + w / 2 + y + d / 2, faces });
}

for (const [tx, ty] of chapter.trees ?? []) {
  const [cx, cy] = project(tx, ty, 0);
  const r = 22;
  const top = cy - 70;
  pieces.push({
    depth: tx + ty,
    faces: [
      { points: `${cx - 3},${cy} ${cx + 3},${cy} ${cx + 3},${cy - 26} ${cx - 3},${cy - 26}`, fill: '#8a6547' },
      { points: `${cx},${top - r} ${cx + r},${top - r / 2} ${cx + r},${top + r / 2} ${cx},${top + r}`, fill: '#5e8f4c' },
      { points: `${cx},${top - r} ${cx - r},${top - r / 2} ${cx - r},${top + r / 2} ${cx},${top + r}`, fill: '#76a95f' },
    ],
  });
}

pieces.sort((a, b) => a.depth - b.depth);

const N = GRID;
const T = 0.45;
const slabTop = pts([[0, 0, 0], [N, 0, 0], [N, N, 0], [0, N, 0]]);
const slabLeft = pts([[0, N, 0], [N, N, 0], [N, N, -T], [0, N, -T]]);
const slabRight = pts([[N, 0, 0], [N, N, 0], [N, N, -T], [N, 0, -T]]);
const road = pts([[0, 10, 0.01], [10, 0, 0.01], [N, 0, 0.01], [N, 1, 0.01], [1, N, 0.01], [0, N, 0.01]]);
const dashes = Array.from({ length: 10 }, (_, i) => {
  const a = project(i + 0.3, N - i - 0.3, 0.02);
  const b = project(i + 0.75, N - i - 0.75, 0.02);
  return { x1: a[0], y1: a[1], x2: b[0], y2: b[1] };
});
---

<svg
  class="iso-scene"
  viewBox={`0 0 ${SCENE_W} ${SCENE_H}`}
  role="img"
  aria-label={`Illustration placeholder: ${chapter.company}`}
  preserveAspectRatio="xMidYMid meet"
>
  <polygon points={slabLeft} fill="#8a6a4a" />
  <polygon points={slabRight} fill="#9c7a57" />
  <polygon points={slabTop} fill={chapter.ground} />
  <polygon points={road} fill="#d9d2c3" />
  {dashes.map((l) => <line {...l} stroke="#f7f3ea" stroke-width="4" stroke-linecap="round" />)}
  {
    pieces.map((p) => (
      <g>
        {p.faces.map((f) =>
          f.d ? (
            <path d={f.d} fill={f.fill} stroke="rgba(40,30,20,0.12)" stroke-width="1" />
          ) : (
            <polygon
              points={f.points}
              fill={f.fill}
              fill-opacity={f.opacity}
              stroke="rgba(40,30,20,0.12)"
              stroke-width="1"
              stroke-linejoin="round"
            />
          ),
        )}
        {p.sign && (
          <text
            transform={p.sign.transform}
            text-anchor="middle"
            dominant-baseline="middle"
            font-family="Geist, sans-serif"
            font-weight="600"
            font-size={p.sign.size.toFixed(1)}
            fill="rgba(255,255,255,0.92)"
          >
            {p.sign.text}
          </text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .iso-scene {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
