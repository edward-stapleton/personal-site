<dialog class="panel" aria-labelledby="panel-title">
  <form method="dialog" class="panel__inner">
    <p class="panel__eyebrow mono-label" data-panel-chapter></p>
    <h3 class="panel__title" id="panel-title" data-panel-title></h3>
    <p class="panel__body" data-panel-body></p>
    <div class="panel__role" data-panel-role-wrap hidden>
      <p class="mono-label">What I Did</p>
      <p data-panel-role></p>
    </div>
    <ul class="panel__links" data-panel-links hidden></ul>
    <div class="panel__nav">
      <button type="button" class="btn btn--ghost" data-panel-prev aria-label="Previous">←</button>
      <span class="mono-label" data-panel-count></span>
      <button type="button" class="btn btn--ghost" data-panel-next aria-label="Next">→</button>
      <button class="btn btn--primary panel__close" value="close">Close</button>
    </div>
  </form>
</dialog>

<style>
  .panel {
    width: min(420px, calc(100vw - 32px));
    margin: auto var(--s-5) calc(var(--rail-h, 0px) + var(--s-5)) auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 60px -24px rgba(20, 15, 10, 0.45);
  }

  .panel::backdrop {
    background: rgba(20, 15, 10, 0.18);
  }

  .panel[open] {
    animation: panel-in var(--dur-slow) var(--ease-out-expressive);
  }

  .panel__inner {
    padding: var(--s-5);
  }

  .panel__eyebrow {
    margin-bottom: var(--s-2);
  }

  .panel__title {
    margin-bottom: var(--s-3);
  }

  .panel__body {
    font-size: var(--fs-base);
    color: var(--ink-2);
    margin-bottom: var(--s-5);
  }

  .panel__role {
    margin: calc(var(--s-5) * -0.5) 0 var(--s-5);
    padding-left: var(--s-3);
    border-left: 2px solid var(--accent);
  }

  .panel__role .mono-label {
    margin-bottom: var(--s-1);
  }

  .panel__links {
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    max-height: 11.5em;
    overflow-y: auto;
    border-top: 1px solid var(--line);
  }

  .panel__links :global(li) {
    border-bottom: 1px solid var(--line);
  }

  .panel__links :global(a) {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-2) 0;
    font-size: var(--fs-sm);
    color: var(--ink);
    text-decoration: none;
  }

  .panel__links :global(a):hover,
  .panel__links :global(a):focus-visible {
    color: var(--accent);
  }

  .panel__links :global(a)::after {
    content: '↗';
    color: var(--ink-3);
  }

  .panel__nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .panel__close {
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .panel {
      width: 100vw;
      max-width: 100vw;
      margin: auto 0 0 0;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
