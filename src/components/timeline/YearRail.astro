---
import { chapters, contact } from '../../data/chapters';

const email = contact.find((c) => c.label === 'Email')!;
const linkedin = contact.find((c) => c.label === 'LinkedIn')!;
---

<header class="tl-header">
  <a href="#today" class="tl-header__mark" data-go="today">
    Ed Stapleton<span class="dot" aria-hidden="true"></span>
  </a>
  <div class="tl-header__links">
    <a href={email.href} class="tl-header__icon" aria-label={`Email ${email.value}`} title="Email">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.75" />
        <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <a href={linkedin.href} class="tl-header__icon" aria-label="LinkedIn profile" title="LinkedIn" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
        <path
          fill="currentColor"
          d="M5.2 8.4h3.1V19H5.2V8.4Zm1.6-5.1a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6ZM10.3 8.4h3v1.5h.1c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V19h-3.1v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V19h-3.1V8.4Z"
        />
      </svg>
    </a>
  </div>
</header>

<nav class="rail" aria-label="Timeline">
  <div class="rail__progress" aria-hidden="true"><span class="rail__fill"></span></div>
  <button class="rail__step" type="button" data-step="-1" aria-label="Previous world" disabled>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <ol class="rail__list">
    {
      chapters.map((c) => (
        <li>
          <a class="rail__item" href={`#${c.id}`} data-go={c.id}>
            <span class="rail__year mono">{c.kind === 'end' ? 'Next' : c.kind === 'intro' ? 'Now' : c.year}</span>
            <span class="rail__name">{c.short}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <button class="rail__step rail__step--next" type="button" data-step="1" aria-label="Next world">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
</nav>

<style>
  .tl-header,
  .rail {
    display: none;
  }

  :global(.js) .tl-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-3) var(--s-5);
    pointer-events: none;
    transition: background var(--dur-std), box-shadow var(--dur-std);
  }

  /* A zoomed-in scene runs up behind the header, so give it a backing. The
     scene stays light in dark mode, and so does this. */
  :global(.js.tl--zoomed) .tl-header {
    background: rgba(250, 248, 243, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(40, 30, 20, 0.08);
  }

  .tl-header > * {
    pointer-events: auto;
  }

  .tl-header__mark {
    border: 0;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    color: #0a0a0b;
  }

  .tl-header__links {
    display: flex;
    gap: var(--s-2);
  }

  .tl-header__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--r-sm);
    background: #0a0a0b;
    color: #fff;
    transition: background var(--dur-std) var(--ease-out-expressive);
  }

  .tl-header__icon:hover {
    background: var(--accent);
  }

  :global(.js) .rail {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0 var(--s-3);
    height: var(--rail-h);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }

  .rail__progress {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
  }

  .rail__fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .rail__step {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition:
      background var(--dur-std) var(--ease-out-expressive),
      color var(--dur-std) var(--ease-out-expressive),
      opacity var(--dur-std) var(--ease-out-expressive);
  }

  .rail__step:hover:not(:disabled) {
    background: var(--ink);
    color: var(--paper);
  }

  .rail__step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Until the visitor first moves, the way forward is the obvious button. */
  :global(.js:not(.tl--travelled)) .rail__step--next {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    animation: step-hint 1.6s var(--ease-out-expressive) 1.5s 3;
  }

  @keyframes step-hint {
    0%,
    60%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(4px);
    }
  }

  .rail__list {
    flex: 1;
    min-width: 0;
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    justify-content: safe center;
  }

  .rail__list::-webkit-scrollbar {
    display: none;
  }

  /* A gentle nudge towards the past until the visitor first moves. */
  :global(.js:not(.tl--travelled)) .rail__list {
    animation: rail-nudge 1.6s var(--ease-out-expressive) 1.5s 3;
  }

  :global(.js:not(.tl--travelled)) li:has(> .rail__item[aria-current='step']) + li .rail__item {
    animation: rail-hint 1.6s ease-in-out 1.5s 3;
  }

  @keyframes rail-nudge {
    0%,
    60%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-10px);
    }
  }

  @keyframes rail-hint {
    0%,
    100% {
      color: var(--ink-4);
    }
    25% {
      color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .rail__list,
    :global(.js) .rail__item,
    :global(.js) .rail__step {
      animation: none !important;
    }
  }

  .rail__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 0 var(--s-3);
    border: 0;
    white-space: nowrap;
    color: var(--ink-4);
    transition: color var(--dur-std) var(--ease-out-expressive);
  }

  .rail__item:hover,
  .rail__item[aria-current='step'] {
    color: var(--ink);
  }

  .rail__year {
    font-size: var(--fs-xs);
    line-height: 1.2;
  }

  .rail__name {
    font-size: var(--fs-xs);
    line-height: 1.3;
  }

  .rail__item[aria-current='step'] .rail__year {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .rail__name {
      display: none;
    }
    .rail__item {
      padding: 0 var(--s-2);
    }
    .tl-header__icon {
      width: 36px;
      height: 36px;
    }
  }
</style>
