---
const items = [
  {
    label: 'Email',
    value: 'edwardstapleton@me.com',
    href: 'mailto:edwardstapleton@me.com',
  },
  {
    label: 'Phone',
    value: '+44 7761 752310',
    href: 'tel:+447761752310',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/edwardstapleton',
    href: 'https://linkedin.com/in/edwardstapleton',
  },
];
---

<section class="contact section" id="contact">
  <div class="container">
    <p class="mono-label section__eyebrow">
      <span>03</span>
      <span class="contact__sep" aria-hidden="true">——</span>
      <span>Contact</span>
    </p>

    <h2 class="section__title">
      Want to work together, or
      <em class="serif-italic">just say hello?</em>
    </h2>

    <ul class="contact__list">
      {
        items.map((item) => (
          <li class="contact__item">
            <span class="mono-label contact__label">{item.label}</span>
            <a class="contact__value" href={item.href}>
              {item.value}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact__sep {
    color: var(--ink-4);
  }

  .section__title em.serif-italic {
    color: var(--ink);
  }

  .contact__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .contact__item {
    display: grid;
    grid-template-columns: 110px 1fr;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .contact__item:first-child {
    border-top: 0;
  }

  .contact__value {
    font-size: var(--fs-md);
    color: var(--ink);
    border-bottom-color: var(--line);
  }

  .contact__value:hover {
    border-bottom-color: var(--accent);
  }
</style>
