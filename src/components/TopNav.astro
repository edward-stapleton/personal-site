---
const links = [
  { label: 'About', href: '#about' },
  { label: 'Work', href: '#career' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="nav">
  <div class="container container--wide nav__inner">
    <a class="nav__wordmark" href="#top" aria-label="Ed Stapleton — home">
      <span>Ed Stapleton</span><span class="dot" aria-hidden="true"></span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .nav__wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--ink);
    border-bottom: 0;
  }

  .nav__wordmark:hover {
    border-bottom: 0;
  }

  .nav__links {
    display: flex;
    gap: var(--s-5);
  }

  .nav__links a {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 0;
  }

  .nav__links a:hover {
    color: var(--ink);
    border-bottom: 0;
  }

  @media (max-width: 480px) {
    .nav__links {
      gap: var(--s-4);
    }
  }
</style>
