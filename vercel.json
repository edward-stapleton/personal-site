{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/place/",
      "destination": "/place",
      "permanent": true
    },
    {
      "source": "/place/pitch-deck",
      "destination": "/place/pitch-deck/",
      "permanent": true
    },
    {
      "source": "/portway",
      "destination": "/portway/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/place",
      "destination": "https://place-control-xi.vercel.app/place"
    },
    {
      "source": "/place/:path*",
      "destination": "https://place-control-xi.vercel.app/place/:path*"
    }
  ]
}
